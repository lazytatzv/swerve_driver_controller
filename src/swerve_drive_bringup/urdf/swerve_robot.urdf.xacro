<?xml version="1.0"?>
<robot name="swerve_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments -->
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="controller_yaml" default=""/>

  <!-- Constants -->
  <xacro:property name="wheelbase" value="0.50"/>
  <xacro:property name="trackwidth" value="0.40"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>

  <!-- Materials -->
  <material name="chassis_mat">
    <color rgba="0.2 0.25 0.3 0.85"/>
  </material>
  <material name="arrow_mat">
    <color rgba="0.1 0.8 0.3 1.0"/>
  </material>
  <material name="axle_mat">
    <color rgba="0.9 0.6 0.1 1.0"/>
  </material>
  <material name="wheel_mat">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="sensor_mat">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="realsense_mat">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <!-- base_footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + 0.04}" rpy="0 0 0"/>
  </joint>

  <!-- base_link (Chassis) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.50 0.04"/>
      </geometry>
      <material name="chassis_mat"/>
    </visual>
    <!-- Forward Direction Pointer Arrow -->
    <visual>
      <origin xyz="0.20 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.04 0.02"/>
      </geometry>
      <material name="arrow_mat"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.60 0.50 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.3" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.6"/>
    </inertial>
  </link>

  <!-- ==================== Sensors ==================== -->
  <!-- 1. RealSense D435 RGB-D Camera -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="realsense_mat"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.28 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Camera Optical Frame (REP-103) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- 2. 3D LiDAR (e.g. Mid-360 / 16-channel 3D LiDAR) -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
      <material name="sensor_mat"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- Macro for Swerve Module -->
  <xacro:macro name="swerve_module" params="prefix x_pos y_pos">
    <!-- Steering Axle Link -->
    <link name="${prefix}_axle_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.04"/>
        </geometry>
        <material name="axle_mat"/>
      </visual>
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>

    <!-- Steering Joint (Rotates around Z, continuous infinite rotation) -->
    <joint name="${prefix}_axle_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_axle_link"/>
      <origin xyz="${x_pos} ${y_pos} -0.02" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" velocity="100.0"/>
    </joint>

    <!-- Wheel Link -->
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_mat"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
      </inertial>
    </link>

    <!-- Drive Wheel Joint (Rotates around Y) -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_axle_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 -${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Gazebo physics properties for wheel -->
    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <!-- Instantiate 4 Modules -->
  <!-- Front Left -->
  <xacro:swerve_module prefix="fl" x_pos="${wheelbase/2.0}" y_pos="${trackwidth/2.0}"/>
  <!-- Front Right -->
  <xacro:swerve_module prefix="fr" x_pos="${wheelbase/2.0}" y_pos="-${trackwidth/2.0}"/>
  <!-- Rear Left -->
  <xacro:swerve_module prefix="rl" x_pos="-${wheelbase/2.0}" y_pos="${trackwidth/2.0}"/>
  <!-- Rear Right -->
  <xacro:swerve_module prefix="rr" x_pos="-${wheelbase/2.0}" y_pos="-${trackwidth/2.0}"/>

  <!-- Gazebo Sensors & Plugins -->
  <xacro:if value="$(arg use_gazebo)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <xacro:if value="${'$(arg controller_yaml)' != ''}">
          <parameters>$(arg controller_yaml)</parameters>
        </xacro:if>
      </plugin>
    </gazebo>

    <!-- RealSense D435 RGB-D Sensor -->
    <gazebo reference="camera_link">
      <sensor name="realsense" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>realsense</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
      </sensor>
    </gazebo>

    <!-- 3D LiDAR Sensor -->
    <gazebo reference="lidar_link">
      <sensor name="lidar3d" type="gpu_lidar">
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.141592653589793</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2617993877991494</min_angle>
              <max_angle>0.2617993877991494</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>lidar3d</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ros2_control description -->
  <ros2_control name="SwerveSystem" type="system">
    <hardware>
      <xacro:if value="$(arg use_gazebo)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_gazebo)">
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
      </xacro:unless>
    </hardware>

    <!-- Front Left -->
    <joint name="fl_axle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <!-- Front Right -->
    <joint name="fr_axle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="fr_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <!-- Rear Left -->
    <joint name="rl_axle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="rl_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>

    <!-- Rear Right -->
    <joint name="rr_axle_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>
    <joint name="rr_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
    </joint>
  </ros2_control>

</robot>
